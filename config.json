{
  "applicationName": "USBSilentCopy",
  "destinationDirectory": "Backup",
  "secondaryDestination": "",
  "enableSecondaryDestination": false,
  "logsDirectory": "logs",
  "historyDirectory": "history",
  "profilesDirectory": "profiles",
  "delayAfterUsbConnectionSeconds": 3,
  "silentMode": false,
  "enableNotifications": true,
  "startupCurrentUser": true,
  "startupAllUsers": false,
  "copyMode": "Copy",
  "speedLimitMBps": 0,
  "maxConcurrentTasks": 1,
  "retryCount": 3,
  "retryDelaySeconds": 5,
  "skipIfFailed": true,
  "preventDiskFull": true,
  "minimumFreeSpaceMB": 500,
  "skipExisting": true,
  "copyOnlyNew": false,
  "compareHash": false,
  "existingFilePolicy": "ReplaceIfNewer",
  "overwriteExistingBackup": true,
  "backupFolderTemplate": "{VolumeLabel}_{DriveLetter}_{Date}_{Time}",
  "copyEmptyDirectories": true,
  "filters": {
    "includeExtensions": [],
    "excludeExtensions": [
      ".tmp",
      ".crdownload",
      ".part"
    ],
    "includeCategories": [],
    "excludeCategories": [],
    "includeFolders": [],
    "excludeFolders": [
      "$RECYCLE.BIN",
      "System Volume Information",
      ".Spotlight-V100",
      ".Trashes"
    ],
    "minSizeMB": null,
    "maxSizeMB": null,
    "modifiedAfter": null,
    "modifiedBefore": null,
    "createdAfter": null,
    "createdBefore": null
  },
  "logging": {
    "enableLogging": true,
    "maxLogSizeBytes": 10485760,
    "maxLogFiles": 10,
    "minLogLevel": "Info"
  },
  "pauseHotkeyEnabled": true
}
